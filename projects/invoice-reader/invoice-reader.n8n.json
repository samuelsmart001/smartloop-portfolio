{
  "name": "Invoice Reader (SamuelSmart Automation)",
  "nodes": [
    {
      "id": "i1",
      "name": "New invoice email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "has:attachment filename:pdf subject:invoice is:unread"
        },
        "options": {
          "downloadAttachments": true
        }
      }
    },
    {
      "id": "i2",
      "name": "Read the PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "attachment_0",
        "options": {}
      }
    },
    {
      "id": "Claude_reads_it",
      "name": "Claude reads it",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 1200, messages: [{ role: 'user', content: \"Extract the invoice data from this text. Reply with ONLY a JSON object: {\\\"vendor\\\": string, \\\"invoice_number\\\": string, \\\"date\\\": \\\"YYYY-MM-DD\\\", \\\"due_date\\\": \\\"YYYY-MM-DD or null\\\", \\\"currency\\\": string, \\\"subtotal\\\": number, \\\"tax\\\": number, \\\"total\\\": number, \\\"items\\\": [{\\\"description\\\": string, \\\"qty\\\": number, \\\"unit_price\\\": number, \\\"amount\\\": number}]}. Use null for anything not on the invoice; never guess numbers.\\n\\nInvoice text:\\n\" + ($json.text || '').slice(0, 15000) }] }) }}",
        "options": {}
      }
    },
    {
      "id": "i4",
      "name": "Clean the data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.content?.[0]?.text || '';\nconst a = text.indexOf('{'), b = text.lastIndexOf('}');\nlet v = {};\ntry { v = JSON.parse(text.slice(a, b + 1)); } catch (e) { v = { vendor: 'CHECK MANUALLY', raw: text }; }\nconst mail = $('New invoice email').first().json;\nreturn [{ json: {\n  logged_at: new Date().toISOString(),\n  vendor: v.vendor ?? '', invoice_number: v.invoice_number ?? '', date: v.date ?? '', due_date: v.due_date ?? '',\n  currency: v.currency ?? '', subtotal: v.subtotal ?? '', tax: v.tax ?? '', total: v.total ?? '',\n  items: (v.items || []).map(i => `${i.qty ?? ''} x ${i.description ?? ''} = ${i.amount ?? ''}`).join('; '),\n  status: 'To pay', email_from: mail.from?.text || mail.from || '', email_subject: mail.subject || '', message_id: mail.id\n} }];"
      }
    },
    {
      "id": "i5",
      "name": "Log the invoice",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        960,
        0
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Invoices"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      }
    },
    {
      "id": "i6",
      "name": "Mark as done",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "operation": "addLabels",
        "messageId": "={{ $('Clean the data').item.json.message_id }}",
        "labelIds": []
      }
    }
  ],
  "connections": {
    "New invoice email": {
      "main": [
        [
          {
            "node": "Read the PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the PDF": {
      "main": [
        [
          {
            "node": "Claude reads it",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude reads it": {
      "main": [
        [
          {
            "node": "Clean the data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clean the data": {
      "main": [
        [
          {
            "node": "Log the invoice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log the invoice": {
      "main": [
        [
          {
            "node": "Mark as done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}